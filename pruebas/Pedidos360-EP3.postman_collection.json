        {
          "name": "Auditoria del pedido (pedidos-auditoria)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const intentos = Number(pm.collectionVariables.get('esperaAuditoria') || 0);",
                  "if (!(pm.response.json().length >= 5) && intentos < 30) {",
                  "    pm.collectionVariables.set('esperaAuditoria', intentos + 1);",
                  "    setTimeout(() => {}, 1000);",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "    return;",
                  "}",
                  "pm.collectionVariables.unset('esperaAuditoria');",
                  "pm.test('Llegaron las 5 acciones', () => pm.expect(pm.response.json().length >= 5).to.be.true);",
                  "const h = pm.response.json();",
                  "pm.test('En orden: CREAR, ACEPTAR, PREPARAR, DESPACHAR, ENTREGAR', () =>",
                  "    pm.expect(h.map(x => x.accion)).to.eql(['CREAR', 'ACEPTAR', 'PREPARAR', 'DESPACHAR', 'ENTREGAR']));",
                  "pm.test('Todas en la misma particion (key = codigo del pedido)', () => pm.expect(new Set(h.map(x => x.particion)).size).to.eql(1));",
                  "pm.test('Offsets crecientes', () => h.forEach((x, i) => { if (i > 0) pm.expect(x.offset).to.be.above(h[i - 1].offset); }));"
                ]
              }
            }
          ],
          "request": {
