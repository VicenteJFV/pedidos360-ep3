                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('3 particiones', () => pm.expect(d.partitions.length).to.eql(3));",
                  "pm.test('Factor de replicacion 3', () => pm.expect(d.replicationFactor).to.eql(3));",
                  "pm.test('ISR completo: ninguna particion sub-replicada', () => pm.expect(d.underReplicated).to.eql(0));",
                  "pm.test('Cada particion tiene lider, 3 replicas y 3 en ISR', () => d.partitions.forEach(p => {",
                  "    pm.expect(p.leader).to.not.be.null;",
                  "    pm.expect(p.replicas.length).to.eql(3);",
